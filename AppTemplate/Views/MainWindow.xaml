<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AppTemplate.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppTemplate.Views"
    xmlns:viewModels="using:AppTemplate.ViewModels"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock
                x:Uid="Main_Header"
                Style="{ThemeResource TitleTextBlockStyle}" />
        </StackPanel>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
                <!-- クリックカウンターカード -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Uid="Main_CounterTitle"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Main_CounterDescription"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <Button
                                x:Uid="Main_ClickButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.IncrementCommand}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.ClickCount.Value, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- テキスト入力同期カード -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Uid="Main_InputTitle"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Main_InputDescription"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBox
                            x:Uid="Main_InputBox"
                            Text="{x:Bind ViewModel.InputText.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.OutputText.Value, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
